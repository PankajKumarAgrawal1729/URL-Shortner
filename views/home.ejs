<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        table,
        th,
        td {
            margin: 10px;
            border: 1px solid black;
        }
    </style>
</head>

<body>
    <h1>URL Shortner</h1>
    <div id="input-cont">
        <form method="post" action="/api/url">
            <label for="url">Enter your original URL</label>
            <input type="text" name="url" id="url" placeholder="https://example.com">
            <button type="submit">Generate</button>
        </form>
    </div>
    <% if(locals.id) { %>
        <div id="output-cont" class="">
            <a href="url/<%=locals.id%>" target="_blank">
                <%=locals.id%>
            </a>
        </div>
        <%}%>
    <% if(locals.urls) { %>
        <table style="width:100%">
                <thead>
                    <tr>
                        <th>S. No.</th>
                        <th>ShortId</th>
                        <th>RedirectUrl</th>
                        <th>Click Count</th>
                    </tr>
                </thead>
                <tbody>
                    <% urls.forEach((url, idx)=> { %>
                        <tr>
                            <td><%= idx + 1 %></td>
                            <td>
                                <%=url.shortUrl%>
                            </td>
                            <td>
                                <%=url.redirectUrl%>
                            </td>
                            <td>
                                <%=url.visitHistory.length%>
                            </td>
                        </tr>
                        <%}); %>
                </tbody>
            </table>
        <% } %>
</body>

</html>